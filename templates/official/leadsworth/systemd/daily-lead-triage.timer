[Unit]
Description=Timer for Pi routine daily-lead-triage

[Timer]
# Template has no machine-readable schedule. Described cadence: Every weekday morning, scores the leads that came in overnight, merges duplicates, and lists what has no owner or is past its response window.
# OnCalendar=Mon..Fri *-*-* 09:00:00
Persistent=true

[Install]
WantedBy=timers.target
