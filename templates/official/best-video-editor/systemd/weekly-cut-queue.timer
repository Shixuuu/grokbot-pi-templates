[Unit]
Description=Timer for Pi routine weekly-cut-queue

[Timer]
# Template has no machine-readable schedule. Described cadence: Run once a week on the day and at the hour the user picked, in the timezone saved in memory. Compute the cron from that timezone and never assume Pacific or UTC. Read the cut queue and the cut log before anything else. For every job with complete direction, do the work: cut it, caption it if captio…
# OnCalendar=Mon..Fri *-*-* 09:00:00
Persistent=true

[Install]
WantedBy=timers.target
