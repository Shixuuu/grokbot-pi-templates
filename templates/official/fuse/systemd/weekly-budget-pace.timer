[Unit]
Description=Timer for Pi routine weekly-budget-pace

[Timer]
# Template has no machine-readable schedule. Described cadence: Every Monday morning, where month-to-date ad spend lands against your plan and which accounts are going to overshoot.
# OnCalendar=Mon..Fri *-*-* 09:00:00
Persistent=true

[Install]
WantedBy=timers.target
