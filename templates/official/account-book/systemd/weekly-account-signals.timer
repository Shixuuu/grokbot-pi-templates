[Unit]
Description=Timer for Pi routine weekly-account-signals

[Timer]
# Template has no machine-readable schedule. Described cadence: Every Monday morning, checks your accounts for public news, funding, leadership, and hiring signals, and reports only what matters to the deal.
# OnCalendar=Mon..Fri *-*-* 09:00:00
Persistent=true

[Install]
WantedBy=timers.target
