[Unit]
Description=Timer for Pi routine evening-interview-prep

[Timer]
# Template has no machine-readable schedule. Described cadence: Run every weekday evening at the hour the user picked, in the timezone saved in memory. Compute the cron from that timezone. Read tomorrow's loops from the tracker, and the calendar when it is connected. For each interview build the packet: the slot time in both the candidate's and the user's timez…
# OnCalendar=Mon..Fri *-*-* 09:00:00
Persistent=true

[Install]
WantedBy=timers.target
