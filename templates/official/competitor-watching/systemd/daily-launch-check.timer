[Unit]
Description=Timer for Pi routine daily-launch-check

[Timer]
# Template has no machine-readable schedule. Described cadence: Each weekday morning, checks changelog, release note, and blog pages across the watch list and speaks up only when a competitor ships something.
# OnCalendar=Mon..Fri *-*-* 09:00:00
Persistent=true

[Install]
WantedBy=timers.target
