[Unit]
Description=Timer for Pi routine weekly-pull-queue

[Timer]
# Template has no machine-readable schedule. Described cadence: Every week, works through the stills and clips waiting in the pull queue and posts each finished file here for review.
# OnCalendar=Mon..Fri *-*-* 09:00:00
Persistent=true

[Install]
WantedBy=timers.target
