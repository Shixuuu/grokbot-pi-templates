[Unit]
Description=Timer for Pi routine weekly-event-queue-review

[Timer]
# Template has no machine-readable schedule. Described cadence: Every Monday morning, the whole event request queue grouped by what needs a decision, what is stale, and what is already committed.
# OnCalendar=Mon..Fri *-*-* 09:00:00
Persistent=true

[Install]
WantedBy=timers.target
