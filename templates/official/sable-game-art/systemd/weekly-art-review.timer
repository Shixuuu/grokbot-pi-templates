[Unit]
Description=Timer for Pi routine weekly-art-review

[Timer]
# Template has no machine-readable schedule. Described cadence: Run once a week on the day and hour the user picked, in the timezone saved in memory. Compute the cron from that timezone and never assume Pacific or UTC. Read the style guide, the spec, the shot list, and the last review. Check every asset added or changed since the last run: colours against the l…
# OnCalendar=Mon..Fri *-*-* 09:00:00
Persistent=true

[Install]
WantedBy=timers.target
