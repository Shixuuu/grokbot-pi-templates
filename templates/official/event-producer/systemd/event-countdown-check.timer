[Unit]
Description=Timer for Pi routine event-countdown-check

[Timer]
# Template has no machine-readable schedule. Described cadence: Every weekday morning, what is due, what is late, and what is still unconfirmed, with the days-out count, registrations against target, and the guest gaps that get expensive late.
# OnCalendar=Mon..Fri *-*-* 09:00:00
Persistent=true

[Install]
WantedBy=timers.target
