[Unit]
Description=Timer for Pi routine daily-spend-check

[Timer]
# Template has no machine-readable schedule. Described cadence: Each weekday morning, checks for a new export and speaks up only about groups over target or spending with nothing to show.
# OnCalendar=Mon..Fri *-*-* 09:00:00
Persistent=true

[Install]
WantedBy=timers.target
