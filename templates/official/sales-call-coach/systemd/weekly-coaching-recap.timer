[Unit]
Description=Timer for Pi routine weekly-coaching-recap

[Timer]
# Template has no machine-readable schedule. Described cadence: Run once a week on the day and hour the user picked, in the timezone saved in memory. Compute the cron from that timezone and never assume Pacific or UTC. Read every scorecard written to the coaching log since the last recap. Send four short parts. The counts for the week, talk share, questions ask…
# OnCalendar=Mon..Fri *-*-* 09:00:00
Persistent=true

[Install]
WantedBy=timers.target
