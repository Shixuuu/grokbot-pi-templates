[Unit]
Description=Timer for Pi routine daily-x-brief

[Timer]
# Template has no machine-readable schedule. Described cadence: Once a day at the hour you pick, reads your watch list and sends the day's items grouped by theme with a link on every line.
# OnCalendar=Mon..Fri *-*-* 09:00:00
Persistent=true

[Install]
WantedBy=timers.target
