[Unit]
Description=Timer for Pi routine pasted-handles

[Timer]
# Template has no machine-readable schedule. Described cadence: When the user pastes one or more X handles, x.com URLs, or profile screenshots in this chat, run maskoff-filter on each. Score every pasted handle with the same weights used on follower or following cards. A city or nationality is zero points by itself. Return a score, verdict, evidence bullets, sh…
# OnCalendar=Mon..Fri *-*-* 09:00:00
Persistent=true

[Install]
WantedBy=timers.target
